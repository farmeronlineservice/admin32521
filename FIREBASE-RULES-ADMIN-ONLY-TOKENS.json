{
  "rules": {
    "adminUids": {
      ".read": true,
      ".write": false
    },

    "settings": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true && newData.exists()"
    },

    "admins": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true && newData.exists()"
    },

    "admin_income": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true"
    },

    "portal_expenses": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true"
    },

    "meta": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true && newData.exists()"
    },

    "users": {
      ".read": true,
      ".write": "newData.exists()",
      "$uid": {
        ".read": true,
        ".write": "newData.exists()",
        "tokens": {
          ".write": "newData.exists() && newData.isNumber() && ( (auth != null && root.child('adminUids').child(auth.uid).val() === true) || (!data.exists() && newData.val() >= 0 && newData.val() <= 5) || (data.exists() && data.isNumber() && newData.val() <= data.val()) )"
        },
        "freeTokens": {
          ".write": "newData.exists() && ( (auth != null && root.child('adminUids').child(auth.uid).val() === true) || !data.exists() || (data.isNumber() && newData.isNumber() && newData.val() <= data.val()) )"
        },
        "status": {
          ".write": "newData.exists() && ( !data.exists() || (auth != null && root.child('adminUids').child(auth.uid).val() === true) )"
        }
      }
    },

    "distributors": {
      ".read": true,
      ".write": "newData.exists()",
      "$did": {
        ".read": true,
        ".write": "newData.exists()",
        "tokens": {
          ".write": "newData.exists() && newData.isNumber() && ( (auth != null && root.child('adminUids').child(auth.uid).val() === true) || (!data.exists() && newData.val() >= 0 && newData.val() <= 5) || (data.exists() && data.isNumber() && newData.val() <= data.val()) )"
        }
      }
    },

    "token_requests": {
      ".read": true,
      ".write": "newData.exists()",
      "$rid": {
        ".read": true,
        ".write": "newData.exists()"
      }
    },

    "usage_logs": {
      ".read": true,
      ".write": "newData.exists()",
      "$lid": {
        ".read": true,
        ".write": "newData.exists()"
      }
    },

    "password_requests": {
      ".read": true,
      ".write": "newData.exists()",
      "$rid": {
        ".read": true,
        ".write": "newData.exists()"
      }
    },

    "services": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true && newData.exists()"
    },

    "service_categories": {
      ".read": true,
      ".write": "auth != null && root.child('adminUids').child(auth.uid).val() === true && newData.exists()"
    },

    "service_requests": {
      ".read": true,
      ".write": "newData.exists()",
      "$rid": {
        ".write": "newData.exists()"
      }
    },

    "token_utrs": {
      ".read": true,
      ".write": "newData.exists()",
      "$utr": {
        ".write": "newData.exists()"
      }
    },

    "device_bindings": {
      ".read": true,
      ".write": "newData.exists()",
      "$key": {
        ".write": "newData.exists()"
      }
    },

    "$other": {
      ".read": false,
      ".write": false
    }
  }
}
